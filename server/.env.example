# Copy to .env (or export directly) to override defaults.

# Bind address. 0.0.0.0 (default) lets phones/emulators on the same
# network reach this machine; use 127.0.0.1 to restrict to local-only.
HOST=0.0.0.0
PORT=3000

# Optional bearer-token auth for all /api/images/* routes.
# Leave unset to disable auth (fine for a local POC).
API_TOKEN=

# Upload limits.
MAX_FILE_MB=25
MAX_DIMENSION=16384
MAX_PIXELS=100000000

# Where images and the JSON "database" live. Defaults to
# ./assets and ./db.json inside the server/ folder.
# ASSETS_DIR=/absolute/path/to/assets
# DB_FILE=/absolute/path/to/db.json

# Dev-only: enables the X-Simulate header used by the app's network tests.
SIMULATE=false
